{
  "uid": "fleetdoctor-fleet",
  "title": "FleetDoctor \u00b7 Fleet",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "timezone": "utc",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Observation age by node",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "fleetdoctor_sample_age_seconds",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Stale node (1 = stale)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "fleetdoctor_node_stale",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Available filesystem space",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_filesystem_available_bytes",
          "legendFormat": "{{node}} {{filesystem}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Filesystem source coverage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_filesystem_coverage_ratio",
          "legendFormat": "{{node}} {{filesystem}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "Fleet incident lifecycle including network paths",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidents"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT id::text, node_id, resource, rule, severity, status, opened_at, observed_at, updated_at, resolved_at, (evidence_reloaded OR now()-observed_at > interval '15 seconds' OR observed_at-now() > interval '2 seconds') AS evidence_stale, CASE rule WHEN 'cpu_saturation' THEN (record->'latest_evidence'->>'cpu_available')::boolean WHEN 'workload_oom' THEN (record->'latest_evidence'->>'memory_available')::boolean WHEN 'inode_exhaustion' THEN (record->'latest_evidence'->>'inode_available')::boolean WHEN 'fd_pressure' THEN (record->'latest_evidence'->>'fd_available')::boolean WHEN 'network_path_degradation' THEN (record->'latest_evidence'->>'network_available')::boolean ELSE (record->'latest_evidence'->>'block_available')::boolean END AS evidence_available FROM incidents WHERE status ~ '${status:raw}' ORDER BY opened_at DESC,id DESC LIMIT 100",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "wrapText": true,
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg"
      }
    },
    {
      "id": 21,
      "title": "Fleet incident evidence and investigation steps",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidents"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT id::text, node_id, resource, status, record->>'diagnosis' AS diagnosis, jsonb_pretty(record->'configuration') AS configuration, jsonb_pretty(record->'opening_evidence') AS opening_evidence, jsonb_pretty(record->'latest_evidence') AS latest_evidence, jsonb_pretty(record->'investigation_steps') AS investigation_steps FROM incidents WHERE status ~ '${status:raw}' ORDER BY opened_at DESC,id DESC LIMIT 25",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "wrapText": true,
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg"
      }
    },
    {
      "id": 22,
      "title": "Observed local discards (agent session gauge)",
      "description": "Last observed reporting, scoped to boot/agent session; may reset. Consult age/stale. Missing discards remain unavailable. Discards do not prove network loss.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_delivery_discard_total",
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 23,
      "title": "Delivery reporting available (absent is unavailable)",
      "description": "Last observed reporting, scoped to boot/agent session; may reset. Consult age/stale. Missing discards remain unavailable. Discards do not prove network loss.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_delivery_reporting_available",
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 24,
      "title": "Delivery observation age",
      "description": "Last observed reporting, scoped to boot/agent session; may reset. Consult age/stale. Missing discards remain unavailable. Discards do not prove network loss.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_sample_age_seconds",
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 30,
      "title": "Host CPU busy",
      "description": "Executed host CPU time; excludes idle, iowait, and steal. Missing intervals stay absent.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 56, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_cpu_busy_ratio", "refId": "A", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 31,
      "title": "Runnable demand versus online cores",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 56, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_cpu_runnable_processes", "refId": "A", "legendFormat": "runnable {{node}}"},
        {"expr": "fleetdoctor_cpu_logical_cores", "refId": "B", "legendFormat": "cores {{node}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 32,
      "title": "CPU load and steal context",
      "description": "Load averages are context, not runnable demand. Steal is separate from executed busy time.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 64, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_cpu_load_1m", "refId": "A", "legendFormat": "load1 {{node}}"},
        {"expr": "fleetdoctor_cpu_load_5m", "refId": "B", "legendFormat": "load5 {{node}}"},
        {"expr": "fleetdoctor_cpu_steal_ratio", "refId": "C", "legendFormat": "steal ratio {{node}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 33,
      "title": "CPU source coverage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 64, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_cpu_coverage_ratio", "refId": "A", "legendFormat": "rule sources {{node}}"},
        {"expr": "fleetdoctor_cpu_process_inventory_available", "refId": "B", "legendFormat": "process inventory {{node}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 40,
      "title": "Host memory available",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 72, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_host_memory_available_bytes", "refId": "A", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 41,
      "title": "Workload memory usage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 72, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_workload_memory_usage_ratio", "refId": "A", "legendFormat": "{{node}} {{cgroup}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 42,
      "title": "Workload local OOM kills",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 80, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_workload_memory_oom_kill_total", "refId": "A", "legendFormat": "{{node}} {{cgroup}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 43,
      "title": "Memory source coverage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 80, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_memory_coverage_ratio", "refId": "A", "legendFormat": "{{node}} {{scope}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 50,
      "title": "Inode usage by filesystem",
      "description": "Fresh statvfs inode usage; missing counters remain absent.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 88, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_filesystem_inode_usage_ratio", "refId": "A", "legendFormat": "{{node}} {{filesystem}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 51,
      "title": "Inode free and total counts",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 88, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_filesystem_inodes_free", "refId": "A", "legendFormat": "free {{node}} {{filesystem}}"},
        {"expr": "fleetdoctor_filesystem_inodes_total", "refId": "B", "legendFormat": "total {{node}} {{filesystem}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 52,
      "title": "Inode diagnosis coverage",
      "description": "Both inode counters and the opening block guard are available and fresh.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 96, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_inode_diagnosis_coverage_ratio", "refId": "A", "legendFormat": "{{node}} {{filesystem}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 53,
      "title": "Active inode incidents",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 96, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_active_incidents{rule=\"inode_exhaustion\"}", "refId": "A", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 60,
      "title": "Fleet FD pressure",
      "description": "Highest fresh exact count/current finite soft-limit ratio per node; missing limits remain absent.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 104, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_fd_pressure_ratio", "refId": "A", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 61,
      "title": "Fleet FD coverage",
      "description": "Exact finite count/limit coverage by node. Prometheus history must be interpreted with observation freshness.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 104, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_fd_coverage_ratio", "refId": "A", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 70,
      "title": "Fleet network packet loss",
      "description": "Measured loss from fresh three-echo probes. Unavailable probes are absent, not zero.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 112, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_network_probe_loss_ratio", "refId": "A", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 71,
      "title": "Fleet network successful-reply median RTT",
      "description": "Median of successful replies only; no-reply and unavailable probes have no RTT series.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 112, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_network_probe_median_rtt_seconds", "refId": "A", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 72,
      "title": "Fleet network collection and attribution coverage",
      "description": "Probe availability, route attribution and incident admission capacity are distinct signals.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 120, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_network_probe_coverage_ratio", "refId": "A", "legendFormat": "probe {{node}}"},
        {"expr": "fleetdoctor_network_route_attribution_available", "refId": "B", "legendFormat": "route {{node}}"},
        {"expr": "fleetdoctor_network_admission_capacity_available", "refId": "C", "legendFormat": "capacity {{node}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 73,
      "title": "Fleet active network path incidents",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 120, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_active_incidents{rule=\"network_path_degradation\"}", "refId": "A", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "status",
        "type": "custom",
        "query": "active,resolved",
        "current": {
          "text": "active",
          "value": "active"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false
      }
    ]
  }
}
