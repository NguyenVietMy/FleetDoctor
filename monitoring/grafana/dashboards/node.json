{
  "uid": "fleetdoctor-node",
  "title": "FleetDoctor \u00b7 Node",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "timezone": "utc",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(fleetdoctor_node_stale,node)",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "status",
        "type": "custom",
        "query": "active,resolved",
        "current": {
          "text": "active",
          "value": "active"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Workload block usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "fleetdoctor_filesystem_block_usage_ratio{node=\"$node\"}",
          "legendFormat": "{{filesystem}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Used and available bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "fleetdoctor_filesystem_used_bytes{node=\"$node\"}",
          "refId": "A",
          "legendFormat": "used {{filesystem}}"
        },
        {
          "expr": "fleetdoctor_filesystem_available_bytes{node=\"$node\"}",
          "refId": "B",
          "legendFormat": "available {{filesystem}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Inode usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_filesystem_inode_usage_ratio{node=\"$node\"}",
          "refId": "A",
          "legendFormat": "{{filesystem}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Observation age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_sample_age_seconds{node=\"$node\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Stale node",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "fleetdoctor_node_stale{node=\"$node\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Filesystem coverage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "fleetdoctor_filesystem_coverage_ratio{node=\"$node\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "Disk, inode, CPU, and OOM incident lifecycle",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidents"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT id::text, node_id, resource, rule, severity, status, opened_at, observed_at, updated_at, resolved_at, (evidence_reloaded OR now()-observed_at > interval '15 seconds' OR observed_at-now() > interval '2 seconds') AS evidence_stale, CASE rule WHEN 'cpu_saturation' THEN (record->'latest_evidence'->>'cpu_available')::boolean WHEN 'workload_oom' THEN (record->'latest_evidence'->>'memory_available')::boolean WHEN 'inode_exhaustion' THEN (record->'latest_evidence'->>'inode_available')::boolean WHEN 'fd_pressure' THEN (record->'latest_evidence'->>'fd_available')::boolean ELSE (record->'latest_evidence'->>'block_available')::boolean END AS evidence_available FROM incidents WHERE status ~ '${status:raw}' AND node_id = ${node:sqlstring} ORDER BY opened_at DESC,id DESC LIMIT 100",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "wrapText": true,
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg"
      }
    },
    {
      "id": 21,
      "title": "Disk, inode, CPU, and OOM evidence and investigation steps",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidents"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT id::text, node_id, resource, status, record->>'diagnosis' AS diagnosis, jsonb_pretty(record->'configuration') AS configuration, jsonb_pretty(record->'opening_evidence') AS opening_evidence, jsonb_pretty(record->'latest_evidence') AS latest_evidence, jsonb_pretty(record->'investigation_steps') AS investigation_steps FROM incidents WHERE status ~ '${status:raw}' AND node_id = ${node:sqlstring} ORDER BY opened_at DESC,id DESC LIMIT 25",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "wrapText": true,
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg"
      }
    },
    {
      "id": 22,
      "title": "Observed local discards (agent session gauge)",
      "description": "Last observed reporting, scoped to boot/agent session; may reset. Consult age/stale. Missing discards remain unavailable. Discards do not prove network loss.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_delivery_discard_total{node=\"$node\"}",
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 23,
      "title": "Delivery reporting available (absent is unavailable)",
      "description": "Last observed reporting, scoped to boot/agent session; may reset. Consult age/stale. Missing discards remain unavailable. Discards do not prove network loss.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_delivery_reporting_available{node=\"$node\"}",
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 24,
      "title": "Delivery observation age",
      "description": "Last observed reporting, scoped to boot/agent session; may reset. Consult age/stale. Missing discards remain unavailable. Discards do not prove network loss.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_sample_age_seconds{node=\"$node\"}",
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 30,
      "title": "Host CPU busy",
      "description": "Executed host CPU time; excludes idle, iowait, and steal.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 64, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_cpu_busy_ratio{node=\"$node\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 31,
      "title": "Runnable demand versus online cores",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 64, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_cpu_runnable_processes{node=\"$node\"}", "refId": "A", "legendFormat": "runnable"},
        {"expr": "fleetdoctor_cpu_logical_cores{node=\"$node\"}", "refId": "B", "legendFormat": "cores"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 32,
      "title": "Load, iowait, and steal context",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 72, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_cpu_load_1m{node=\"$node\"}", "refId": "A", "legendFormat": "load1"},
        {"expr": "fleetdoctor_cpu_iowait_ratio{node=\"$node\"}", "refId": "B", "legendFormat": "iowait ratio"},
        {"expr": "fleetdoctor_cpu_steal_ratio{node=\"$node\"}", "refId": "C", "legendFormat": "steal ratio"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 33,
      "title": "CPU source coverage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 72, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_cpu_coverage_ratio{node=\"$node\"}", "refId": "A", "legendFormat": "rule sources"},
        {"expr": "fleetdoctor_cpu_process_inventory_available{node=\"$node\"}", "refId": "B", "legendFormat": "process inventory"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 40,
      "title": "Host memory available",
      "description": "Host scope remains separate from configured workload cgroups.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 80, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_host_memory_available_bytes{node=\"$node\"}", "refId": "A", "legendFormat": "host available"},
        {"expr": "fleetdoctor_host_swap_free_bytes{node=\"$node\"}", "refId": "B", "legendFormat": "host swap free"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 41,
      "title": "Workload memory usage",
      "description": "Ratios may temporarily exceed 100%; missing and unlimited limits remain absent.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 80, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_workload_memory_usage_ratio{node=\"$node\"}", "refId": "A", "legendFormat": "{{cgroup}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 42,
      "title": "Workload local OOM kills",
      "description": "Cumulative exact-cgroup memory.events.local counters; increases drive the rule.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 88, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_workload_memory_oom_kill_total{node=\"$node\"}", "refId": "A", "legendFormat": "{{cgroup}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 43,
      "title": "Memory source coverage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 88, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_memory_coverage_ratio{node=\"$node\"}", "refId": "A", "legendFormat": "{{scope}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 50,
      "title": "Inode free and total counts",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 96, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_filesystem_inodes_free{node=\"$node\"}", "refId": "A", "legendFormat": "free {{filesystem}}"},
        {"expr": "fleetdoctor_filesystem_inodes_total{node=\"$node\"}", "refId": "B", "legendFormat": "total {{filesystem}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 51,
      "title": "Inode diagnosis coverage",
      "description": "Both inode counters and the opening block guard are available and fresh.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 96, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_inode_diagnosis_coverage_ratio{node=\"$node\"}", "refId": "A", "legendFormat": "{{filesystem}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 52,
      "title": "Active inode incidents",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 104, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_active_incidents{node=\"$node\",rule=\"inode_exhaustion\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 60,
      "title": "FD pressure (maximum observed)",
      "description": "Highest fresh exact count/current finite soft-limit ratio on this node. Missing or infinite limits remain absent, not zero.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 112, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_fd_pressure_ratio{node=\"$node\"}", "refId": "A", "legendFormat": "maximum pressure"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 61,
      "title": "FD collection coverage",
      "description": "Exact finite count/limit coverage and durable incident admission availability. History is not current-state proof without freshness.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 112, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_fd_coverage_ratio{node=\"$node\"}", "refId": "A", "legendFormat": "exact count/limit"},
        {"expr": "fleetdoctor_fd_admission_capacity_available{node=\"$node\"}", "refId": "B", "legendFormat": "admission capacity"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 62,
      "title": "Active FD incidents",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 120, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_active_incidents{node=\"$node\",rule=\"fd_pressure\"}", "refId": "A", "legendFormat": "active"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 63,
      "title": "FD incident evidence",
      "description": "Readable vertical detail for the latest matching FD incident: explicit incident and boot-scoped process identity, measured count/current limit, growth or unavailable state, coverage, lifecycle reason, diagnosis, and investigation steps. Positive growth supports suspected leakage; it does not prove cause.",
      "type": "table",
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "incidents"},
      "gridPos": {"x": 0, "y": 128, "w": 24, "h": 24},
      "targets": [{
        "refId": "A",
        "format": "table",
        "rawQuery": true,
        "rawSql": "WITH selected AS (SELECT id, status, observed_at, evidence_reloaded, record FROM incidents WHERE rule='fd_pressure' AND status ~ '${status:raw}' AND node_id=${node:sqlstring} ORDER BY opened_at DESC,id DESC LIMIT 1), details AS (SELECT detail.ordinal, detail.field, detail.value FROM selected CROSS JOIN LATERAL (VALUES (10, 'Incident ID', id::text), (20, 'Status', status), (30, 'Resolution reason', COALESCE(record->>'resolution_reason','active')), (40, 'Boot ID', COALESCE(record->'latest_evidence'->'identity'->>'boot_id','unavailable')), (50, 'PID / starttime ticks', COALESCE(record->'latest_evidence'->'identity'->>'pid','?') || ' / ' || COALESCE(record->'latest_evidence'->'identity'->>'starttime_ticks','?')), (60, 'Descriptor count / actual soft limit', COALESCE(record->'latest_evidence'->'observation'->>'descriptor_count','unavailable') || ' / ' || COALESCE(record->'latest_evidence'->'observation'->>'soft_limit','unavailable')), (70, 'Pressure ratio', COALESCE(record->'latest_evidence'->'observation'->>'pressure_ratio','unavailable')), (80, 'Growth delta / rate / interval', COALESCE(record->'latest_evidence'->'observation'->>'count_delta','unavailable') || ' / ' || COALESCE(record->'latest_evidence'->'observation'->>'growth_per_second','unavailable') || ' / ' || COALESCE(record->'latest_evidence'->'observation'->>'growth_interval_seconds','unavailable')), (90, 'Observation status / errors', COALESCE(record->'latest_evidence'->>'status','unknown') || ' / ' || COALESCE(record->'latest_evidence'->'observation'->>'errors','[]')), (100, 'FD available / watch coverage', COALESCE(record->'latest_evidence'->>'fd_available','false') || ' / ' || COALESCE(record->'latest_evidence'->'coverage'->>'watch','unavailable')), (110, 'Evidence stale', (evidence_reloaded OR now()-observed_at > interval '15 seconds' OR observed_at-now() > interval '2 seconds')::text), (120, 'Diagnosis', COALESCE(record->>'diagnosis','unavailable'))) AS detail(ordinal,field,value)), steps AS (SELECT 200 + step.ordinality::integer AS ordinal, 'Investigation step ' || step.ordinality::text AS field, step.value FROM selected CROSS JOIN LATERAL jsonb_array_elements_text(COALESCE(record->'investigation_steps','[]'::jsonb)) WITH ORDINALITY AS step(value,ordinality)) SELECT display.field, display.value FROM (SELECT ordinal, field, value FROM details UNION ALL SELECT ordinal, field, value FROM steps) AS display ORDER BY display.ordinal"
      }],
      "fieldConfig": {"defaults": {"custom": {"cellOptions": {"type": "auto"}, "wrapText": true, "filterable": false, "inspect": true}}, "overrides": [{"matcher": {"id": "byName", "options": "field"}, "properties": [{"id": "custom.width", "value": 300}]}]},
      "options": {"showHeader": true, "cellHeight": "md", "footer": {"show": false}}
    }
  ]
}
