[Unit]
Description=FleetDoctor host filesystem agent
Wants=network-online.target
After=network-online.target
Requires=fleetdoctor-disk-prepare.service
After=fleetdoctor-disk-prepare.service

[Service]
Type=simple
User=fleetdoctor
EnvironmentFile=/etc/fleetdoctor/agent.env
LoadCredential=ingest-token:/etc/fleetdoctor/ingest-token
ExecStart=/opt/fleetdoctor/venv/bin/fleetdoctor-agent
ExecStartPre=/bin/sh /opt/fleetdoctor/current/deploy/check-agent-mount.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=100M
TasksMax=16
UMask=0077

[Install]
WantedBy=multi-user.target
