{
  "uid": "fleetdoctor-fleet",
  "title": "FleetDoctor \u00b7 Fleet",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "timezone": "utc",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Observation age by node",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "fleetdoctor_sample_age_seconds",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Stale node (1 = stale)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "fleetdoctor_node_stale",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Available filesystem space",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_filesystem_available_bytes",
          "legendFormat": "{{node}} {{filesystem}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Filesystem source coverage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_filesystem_coverage_ratio",
          "legendFormat": "{{node}} {{filesystem}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "CPU and disk incident lifecycle",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidents"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT id::text, node_id, resource, rule, severity, status, opened_at, observed_at, updated_at, resolved_at, (evidence_reloaded OR now()-observed_at > interval '15 seconds' OR observed_at-now() > interval '2 seconds') AS evidence_stale, CASE rule WHEN 'cpu_saturation' THEN (record->'latest_evidence'->>'cpu_available')::boolean ELSE (record->'latest_evidence'->>'block_available')::boolean END AS evidence_available FROM incidents WHERE status ~ '${status:raw}' ORDER BY opened_at DESC,id DESC LIMIT 100",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "wrapText": true,
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg"
      }
    },
    {
      "id": 21,
      "title": "CPU and disk evidence and investigation steps",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidents"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT id::text, node_id, resource, status, record->>'diagnosis' AS diagnosis, jsonb_pretty(record->'configuration') AS configuration, jsonb_pretty(record->'opening_evidence') AS opening_evidence, jsonb_pretty(record->'latest_evidence') AS latest_evidence, jsonb_pretty(record->'investigation_steps') AS investigation_steps FROM incidents WHERE status ~ '${status:raw}' ORDER BY opened_at DESC,id DESC LIMIT 25",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "wrapText": true,
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg"
      }
    },
    {
      "id": 22,
      "title": "Observed local discards (agent session gauge)",
      "description": "Last observed reporting, scoped to boot/agent session; may reset. Consult age/stale. Missing discards remain unavailable. Discards do not prove network loss.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_delivery_discard_total",
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 23,
      "title": "Delivery reporting available (absent is unavailable)",
      "description": "Last observed reporting, scoped to boot/agent session; may reset. Consult age/stale. Missing discards remain unavailable. Discards do not prove network loss.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_delivery_reporting_available",
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 24,
      "title": "Delivery observation age",
      "description": "Last observed reporting, scoped to boot/agent session; may reset. Consult age/stale. Missing discards remain unavailable. Discards do not prove network loss.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "fleetdoctor_sample_age_seconds",
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 30,
      "title": "Host CPU busy",
      "description": "Executed host CPU time; excludes idle, iowait, and steal. Missing intervals stay absent.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 56, "w": 12, "h": 8},
      "targets": [{"expr": "fleetdoctor_cpu_busy_ratio", "refId": "A", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 31,
      "title": "Runnable demand versus online cores",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 56, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_cpu_runnable_processes", "refId": "A", "legendFormat": "runnable {{node}}"},
        {"expr": "fleetdoctor_cpu_logical_cores", "refId": "B", "legendFormat": "cores {{node}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 32,
      "title": "CPU load and steal context",
      "description": "Load averages are context, not runnable demand. Steal is separate from executed busy time.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 64, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_cpu_load_1m", "refId": "A", "legendFormat": "load1 {{node}}"},
        {"expr": "fleetdoctor_cpu_load_5m", "refId": "B", "legendFormat": "load5 {{node}}"},
        {"expr": "fleetdoctor_cpu_steal_ratio", "refId": "C", "legendFormat": "steal ratio {{node}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    },
    {
      "id": 33,
      "title": "CPU source coverage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 64, "w": 12, "h": 8},
      "targets": [
        {"expr": "fleetdoctor_cpu_coverage_ratio", "refId": "A", "legendFormat": "rule sources {{node}}"},
        {"expr": "fleetdoctor_cpu_process_inventory_available", "refId": "B", "legendFormat": "process inventory {{node}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"spanNulls": false, "insertNulls": false}}, "overrides": []}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "status",
        "type": "custom",
        "query": "active,resolved",
        "current": {
          "text": "active",
          "value": "active"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false
      }
    ]
  }
}
